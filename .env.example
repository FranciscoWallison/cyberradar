# Copie para .env só para rodar NA SUA MÁQUINA (o .env está no .gitignore).
# No GitHub, cadastre os mesmos nomes em Settings → Secrets and variables → Actions.
# TODOS são opcionais: sem eles o pipeline funciona com limites menores e textos automáticos.

# ---- Site (no GitHub: aba "Variables", não "Secrets") ----
SITE_URL=https://SEU-USUARIO.github.io
SITE_BASE_PATH=/NOME-DO-REPOSITORIO
FEEDBACK_URL=

# ---- Fontes de dados ----
NVD_API_KEY=
# GITHUB_TOKEN é automático no Actions; localmente use um token sem escopos (fine-grained, só leitura pública)
GITHUB_TOKEN=

# ---- IA (qualquer combinação; ordem de uso em config/settings.toml) ----
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
MISTRAL_API_KEY=
# IA local (Ollama no seu PC): OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:4b

# ---- Alertas ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
